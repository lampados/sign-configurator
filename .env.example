# WooCommerce shop that "Send request" takes the customer to (SPEC §15).
# Locally: copy to .env.local (ignored by git). In production: Cloudflare Pages build
# variables (Settings → Variables and secrets), for Production and for Preview.
# Without these two variables "Send request" does not appear and only "Download STL" stays.
VITE_SHOP_URL=https://shop.example.com
# ID of the generic product the shop attaches the design to.
VITE_SHOP_PRODUCT_ID=123
# Page to support the project (Ko-fi, Buy Me a Coffee, ...): the "Offer me a coffee" invitation
# under the name and under "Download STL" (SPEC §16). Without this variable it does not appear.
VITE_SUPPORT_URL=https://ko-fi.com/yourname
